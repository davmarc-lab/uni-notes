\usepackage{textcomp}
\usepackage{xcolor}
\usepackage[most]{tcolorbox}
\tcbuselibrary{listings, breakable, skins}

\lstalias{py}{Python}
\lstalias{cpp}{C++}

\lstset{
    showstringspaces=false,
    basicstyle=\scriptsize\ttfamily,
    commentstyle={\color{olive}},
    identifierstyle=\color{black},
    ndkeywordstyle={\color{blue}},
    stringstyle={\color{magenta}},
    emphstyle={},
    keywordstyle={\color{blue}},
    breaklines=true,
    tabsize=2,
}

% shorthand command for the prompt to save typing
\newcommand{\prompt}{\textcolor{green}{user@linux:~\$} }
\newcommand{\rootprompt}{\textcolor{red}{root@linux:~\$} }

\newtcblisting{terminal}[1]{
    enhanced,
    listing only,
    breakable,
    colback=black!95,
    colframe=gray!70,
    colupper=white,
    arc=6pt,
    boxrule=1pt,
    code={\ifstrempty{#1}{}{\tcbset{title={\small\ttfamily #1}}}},
    fonttitle=\bfseries\ttfamily,
    coltitle=white,
    left=5pt,
    listing options={
        language=bash,
        basicstyle=\ttfamily\small\color{white},
        upquote=true,
        breaklines=true,
        showstringspaces=false,
        escapeinside={(*}{*)},      % 'escape' characters to use latex commands
        keywordstyle=\color{cyan},
        commentstyle=\color{gray!60},
        stringstyle=\color{orange}
    }
}

\newtcblisting{codeblock}[2][bash]{
    enhanced,
    listing only,
    breakable,
    colback=code-bg,
    colframe=gh-gray-border,
    arc=6pt,
    boxrule=0.5pt,
    top=10pt,
    bottom=10pt,
    left=10pt,
    listing options={
        language=#1,
        basicstyle=\ttfamily\small,
        upquote=true,
        keywordstyle=\color{blue},
        commentstyle=\color{gray},
        stringstyle=\color{orange},
        breaklines=true,
        showstringspaces=false,
        tabsize=2,
    },
    title={#2},
    coltitle=black,
    attach boxed title to top left={yshift=-2mm, xshift=5mm},
    boxed title style={colback=white, colframe=gh-gray-border, sharp corners, boxrule=0.5pt}
}

% --- Command to include external files ---
\newcommand{\codefile}[3][bash]{
    \tcbinputlisting{
        enhanced,
        listing file={#3},
        listing only,
        breakable,
        colback=code-bg,
        colframe=gh-gray-border,
        arc=6pt,
        boxrule=0.5pt,
        top=10pt,
        bottom=10pt,
        left=10pt,
        listing options={
            language=#1,
            upquote=true,
            basicstyle=\ttfamily\small,
            keywordstyle=\color{blue},
            commentstyle=\color{gray},
            stringstyle=\color{orange},
            breaklines=true,
            showstringspaces=false,
            tabsize=2,
        },
        title={#2},
        coltitle=black,
        attach boxed title to top left={yshift=-2mm, xshift=5mm},
        boxed title style={colback=white, colframe=gh-gray-border, sharp corners, boxrule=0.5pt}
    }
}

\lstdefinelanguage{txt}{}

\lstdefinelanguage{fsp}{
    comment=[l]{//},
    morecomment=[s]{/*}{*/},
    keywords={if, then, else, when, property, const, range, progress, forall},
    otherkeywords={STOP, ERROR, END},
    sensitive=true,
    morestring=[b]",
    morestring=[b]',
    alsoletter={-, >, |, :, ., @, \{, \}, [, ]},
    literate=
        {->}{{$\to\,$}}2
        {||}{{$\parallel\,$}}2
        {::}{{$::\,$}}2
        {..}{{$\dots\,$}}2
        {...}{{$\dots\,$}}2
        {=}{{$=\,$}}1
        {|}{{|}}1,
}[keywords, comments, strings]

\lstdefinelanguage{Kotlin}{
    comment=[l]{//},
    emph={delegate, filter, first, firstOrNull, forEach, lazy, map, mapNotNull, println, return@},
    keywords={abstract, actual, as, as?, break, by, class, companion, continue, data, do, dynamic, else, enum, expect, false, final, for, fun, get, if, import, in, interface, internal, is, null, object, override, package, private, public, return, set, super, suspend, this, throw, true, try, typealias, val, var, vararg, when, where, while},
    morecomment=[s]{/*}{*/},
    morestring=[b]",
    morestring=[s]{"""*}{*"""},
    ndkeywords={@Deprecated, @JvmField, @JvmName, @JvmOverloads, @JvmStatic, @JvmSynthetic, Array, Byte, Double, Float, Int, Integer, Iterable, Long, Runnable, Short, String, Unit, it},
    sensitive=true
}

% JavaScript version 1.1 by Gary Hammock
% Reference:
%   B. Eich and C. Rand Mckinney, "JavaScript Language Specification
%     (Preliminary Draft)", JavaScript 1.1.  1996-11-18.  [Online]
%     http://hepunx.rl.ac.uk/~adye/jsspec11/titlepg2.htm
%
\lstdefinelanguage{js}{
    morekeywords=[1]{await, async, case, catch, class, const, default, do, enum, export, extends, finally, from, implements, require, import, as, instanceof, let, static, super, switch, throw, try, break, continue, delete, else, for, function, if, in, new, return, this, typeof, var, void, while, with},
    % Literals, primitive types, and reference types.
    morekeywords=[2]{false, null, true, boolean, number, undefined,
    Array, Boolean, Date, Math, Number, String, Object},
    % Built-ins.
    morekeywords=[3]{eval, parseInt, parseFloat, escape, unescape},
    sensitive,
    morecomment=[s]{/*}{*/},
    morecomment=[l]//,
    morecomment=[s]{/**}{*/}, % JavaDoc style comments
    morestring=[b]',
    morestring=[b]"
}[keywords, comments, strings]
